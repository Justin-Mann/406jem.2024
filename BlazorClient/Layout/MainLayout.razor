@inherits LayoutComponentBase
@inject BlazorApp.BlazorClient.Services.AuthenticationService AuthService
@inject NavigationManager NavigationManager

<MudLayout>
    <MudAppBar Elevation="0" Color="Color.Transparent" Class="jem-appbar" Fixed="false">
        <div class="top-menu-row jem-appbar-inner">
            <div class="top-menu">
                <MudNavMenu Class="jem-nav-desktop">
                    <MudNavLink Href="/" Match="NavLinkMatch.All">Home</MudNavLink>
                    <MudNavLink Href="/digitalresume">Digital Resume</MudNavLink>
                    <MudNavLink Href="/projects">Current Project(s)</MudNavLink>
                    <MudNavLink Href="/testimonials">Testimonials</MudNavLink>
                    <MudNavLink Href="/resume-posters">Contact a Poster</MudNavLink>
                    <AuthorizeView>
                        <Authorized>
                            <span class="auth-status">Hi, @context.User.Identity?.Name</span>
                            <MudNavLink OnClick="HandleLogoutAsync">Log Out</MudNavLink>
                        </Authorized>
                        <NotAuthorized>
                            <MudNavLink Href="/login">Log In</MudNavLink>
                            <MudNavLink Href="/register">Register</MudNavLink>
                        </NotAuthorized>
                    </AuthorizeView>
                </MudNavMenu>

                <MudIconButton Icon="@Icons.Material.Filled.Menu"
                                Color="Color.Primary"
                                Class="jem-nav-mobile-btn"
                                aria-label="Open navigation menu"
                                OnClick="@(() => drawerOpen = true)" />
            </div>
        </div>
    </MudAppBar>

    <MudDrawer @bind-Open="drawerOpen" Anchor="Anchor.Top" Elevation="2" Variant="DrawerVariant.Temporary" Class="jem-nav-drawer">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" OnClick="CloseDrawer">Home</MudNavLink>
            <MudNavLink Href="/digitalresume" OnClick="CloseDrawer">Digital Resume</MudNavLink>
            <MudNavLink Href="/projects" OnClick="CloseDrawer">Current Project(s)</MudNavLink>
            <MudNavLink Href="/testimonials" OnClick="CloseDrawer">Testimonials</MudNavLink>
            <MudNavLink Href="/resume-posters" OnClick="CloseDrawer">Contact a Poster</MudNavLink>
            <AuthorizeView>
                <Authorized>
                    <MudText Class="auth-status px-4 py-2">Hi, @context.User.Identity?.Name</MudText>
                    <MudNavLink OnClick="HandleLogoutFromDrawerAsync">Log Out</MudNavLink>
                </Authorized>
                <NotAuthorized>
                    <MudNavLink Href="/login" OnClick="CloseDrawer">Log In</MudNavLink>
                    <MudNavLink Href="/register" OnClick="CloseDrawer">Register</MudNavLink>
                </NotAuthorized>
            </AuthorizeView>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent Class="content px-4">
        @Body
        <div class="fixed-row-bottom">
            <img class="bojack-footer" src="img/bojack-samuri_bookends_780x100.png" />
        </div>
    </MudMainContent>
</MudLayout>

@code {
    private bool drawerOpen;

    private void CloseDrawer() => drawerOpen = false;

    private async Task HandleLogoutAsync()
    {
        await AuthService.LogoutAsync();
        NavigationManager.NavigateTo("/", forceLoad: false);
    }

    private async Task HandleLogoutFromDrawerAsync()
    {
        CloseDrawer();
        await HandleLogoutAsync();
    }
}
