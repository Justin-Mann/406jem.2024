@page "/digitalresume"
@using BlazorApp.Models
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Digital Resume</PageTitle>

@if (myResume.Id == null)
{
    <MudText Typo="Typo.h5" Align="Align.Center">No Resume Records Found.</MudText>
}
else
{
    @if (loadingMessageShow)
    {
        <MudText Typo="Typo.h5" Align="Align.Center" Class="resume-loading-message">Give it a Second..<br />The API had to cold start.</MudText>
    }
    else
    {
        <MudContainer MaxWidth="MaxWidth.Large">
            <MudGrid Justify="Justify.Center">
                <MudItem xs="12" sm="6">
                    <MudButton Href="docs/jmResume.8.2025.pdf" Target="_new" Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" FullWidth="true">PDF V2 (ATS Friendly)</MudButton>
                </MudItem>
                @if (ContactEmail != null)
                {
                    <MudItem xs="12" sm="6">
                        <MudButton Href="@($"mailto:{ContactEmail}")" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" FullWidth="true" id="contact-me-button">Contact Me</MudButton>
                    </MudItem>
                }
            </MudGrid>
            <MudGrid Class="header">
                <MudItem xs="2" id="logo"><MudImage Src="@myResume.LogoFile" Alt="" /></MudItem>
                <MudItem xs="6">
                    <span id="name" class="h1 text-uppercase">@myResume.FName @myResume.MName @myResume.LName</span><br />
                    <span id="position" class="h3 text-uppercase">@myResume.Position</span><br />
                    <span id="subtitle" class="text-uppercase">@myResume.Subtitle</span>
                </MudItem>
                <MudItem xs="4"><p id="simplegoal">@myResume.SimpleGoal</p></MudItem>
            </MudGrid>
            <MudGrid>
                <MudItem xs="12" sm="8">
                    <GeneralSection SectionName="Profile" Items="@myResume.Profile"></GeneralSection>
                    <WorkExperienceSection WorkExperienceInfo="@myResume.WorkExperience"></WorkExperienceSection>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <ContactSection ContactInfo="@myResume.Contact"></ContactSection>
                    <EducationSection EducationInfo="@myResume.Education"></EducationSection>
                    <CustomSections CSections="@myResume.CustomSections"></CustomSections>
                </MudItem>
            </MudGrid>
        </MudContainer>
    }
}

@code {
    private DigitalResumeModel myResume = new DigitalResumeModel();
    private bool loadingMessageShow = true;

    private string? ContactEmail =>
        myResume.Contact?.FirstOrDefault(c => c.Type == ContactTypeEnum.Email && !string.IsNullOrWhiteSpace(c.MailTo))?.MailTo;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            myResume = await Http.GetFromJsonAsync<DigitalResumeModel>("/api/resumes/myresume");
            loadingMessageShow = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }
}
