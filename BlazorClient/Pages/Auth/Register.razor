@page "/register"
@using BlazorApp.BlazorClient.Services
@inject AuthenticationService AuthService
@inject NavigationManager Nav

<PageTitle>Register</PageTitle>

<div class="container">
    <div class="row">
        <div class="col col-sm-6 col-12 offset-sm-3">
            <h2>Create an Account</h2>
            <EditForm Model="model" OnValidSubmit="HandleRegisterAsync">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <InputText id="username" class="form-control" @bind-Value="model.Username" />
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <InputText id="email" class="form-control" @bind-Value="model.Email" />
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <InputText id="password" type="password" class="form-control" @bind-Value="model.Password" />
                    <div class="form-text">At least 8 characters.</div>
                </div>
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <div class="alert alert-danger">@errorMessage</div>
                }
                <button type="submit" class="btn btn-primary" disabled="@isBusy">Register</button>
            </EditForm>
            <p class="mt-3">Already have an account? <a href="/login">Log in</a></p>
        </div>
    </div>
</div>

@code {
    private readonly RegisterModel model = new();
    private string? errorMessage;
    private bool isBusy;

    private async Task HandleRegisterAsync()
    {
        isBusy = true;
        errorMessage = await AuthService.RegisterAsync(model.Username, model.Email, model.Password);
        if (errorMessage is null)
        {
            errorMessage = await AuthService.LoginAsync(model.Username, model.Password);
        }
        isBusy = false;

        if (errorMessage is null)
        {
            Nav.NavigateTo("/testimonials");
        }
    }

    private class RegisterModel
    {
        [Required]
        public string Username { get; set; } = string.Empty;

        [Required, EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required, MinLength(8)]
        public string Password { get; set; } = string.Empty;
    }
}
