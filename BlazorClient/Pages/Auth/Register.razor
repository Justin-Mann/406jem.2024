@page "/register"
@using BlazorApp.BlazorClient.Services
@inject AuthenticationService AuthService
@inject NavigationManager Nav

<PageTitle>Register</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small">
    <MudGrid Justify="Justify.Center">
        <MudItem xs="12" sm="8">
            <MudCard Class="jem-card" Elevation="0">
                <MudCardContent>
                    <MudText Typo="Typo.h5" Class="mb-4">Create an Account</MudText>
                    <EditForm Model="model" OnValidSubmit="HandleRegisterAsync">
                        <DataAnnotationsValidator />
                        <MudTextField T="string" Label="Username" @bind-Value="model.Username" For="@(() => model.Username)" Class="mb-3" />
                        <MudTextField T="string" Label="Email" @bind-Value="model.Email" For="@(() => model.Email)" Class="mb-3" />
                        <MudTextField T="string" Label="Password" InputType="InputType.Password" @bind-Value="model.Password" For="@(() => model.Password)" HelperText="At least 8 characters." Class="mb-3" />
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <MudAlert Severity="Severity.Error" Class="mb-3">@errorMessage</MudAlert>
                        }
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@isBusy">Register</MudButton>
                    </EditForm>
                    <MudText Class="mt-3">Already have an account? <MudLink Href="/login">Log in</MudLink></MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private readonly RegisterModel model = new();
    private string? errorMessage;
    private bool isBusy;

    private async Task HandleRegisterAsync()
    {
        isBusy = true;
        errorMessage = await AuthService.RegisterAsync(model.Username, model.Email, model.Password);
        if (errorMessage is null)
        {
            errorMessage = await AuthService.LoginAsync(model.Username, model.Password);
        }
        isBusy = false;

        if (errorMessage is null)
        {
            Nav.NavigateTo("/testimonials");
        }
    }

    private class RegisterModel
    {
        [Required]
        public string Username { get; set; } = string.Empty;

        [Required, EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required, MinLength(8)]
        public string Password { get; set; } = string.Empty;
    }
}
