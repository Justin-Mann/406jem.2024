@page "/login"
@using BlazorApp.BlazorClient.Services
@inject AuthenticationService AuthService
@inject NavigationManager Nav

<PageTitle>Log In</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small">
    <MudGrid Justify="Justify.Center">
        <MudItem xs="12" sm="8">
            <MudCard Class="jem-card" Elevation="0">
                <MudCardContent>
                    <MudText Typo="Typo.h5" Class="mb-4">Log In</MudText>
                    <EditForm Model="model" OnValidSubmit="HandleLoginAsync">
                        <DataAnnotationsValidator />
                        <MudTextField T="string" Label="Username" @bind-Value="model.Username" For="@(() => model.Username)" Class="mb-3" />
                        <MudTextField T="string" Label="Password" InputType="InputType.Password" @bind-Value="model.Password" For="@(() => model.Password)" Class="mb-3" />
                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <MudAlert Severity="Severity.Error" Class="mb-3">@errorMessage</MudAlert>
                        }
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@isBusy">Log In</MudButton>
                    </EditForm>
                    <MudText Class="mt-3">Don't have an account? <MudLink Href="/register">Register</MudLink></MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>
    </MudGrid>
</MudContainer>

@code {
    private readonly LoginModel model = new();
    private string? errorMessage;
    private bool isBusy;

    private async Task HandleLoginAsync()
    {
        isBusy = true;
        errorMessage = await AuthService.LoginAsync(model.Username, model.Password);
        isBusy = false;

        if (errorMessage is null)
        {
            Nav.NavigateTo("/");
        }
    }

    private class LoginModel
    {
        [Required]
        public string Username { get; set; } = string.Empty;

        [Required]
        public string Password { get; set; } = string.Empty;
    }
}
