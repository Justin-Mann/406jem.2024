@page "/resume-posters"
@using BlazorApp.Models
@inject HttpClient Http

<PageTitle>Contact a Resume Poster</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium">
    <MudText Typo="Typo.h4" Class="mb-2">Contact a Resume Poster</MudText>
    <MudText Class="mb-4">Reach out directly to one of our registered resume posters — your message is relayed by email without ever exposing their address.</MudText>

    @if (posters is null)
    {
        <MudText>Loading...</MudText>
    }
    else if (posters.Count == 0)
    {
        <MudText>No resume posters are registered yet.</MudText>
    }
    else
    {
        <ul class="resume-poster-list">
            @foreach (var poster in posters)
            {
                <li class="mb-3">
                    <strong>@poster.DisplayName</strong>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => ToggleForm(poster.Id)">
                        @(openPosterId == poster.Id ? "Close" : "Contact")
                    </MudButton>

                    @if (openPosterId == poster.Id)
                    {
                        <EditForm Model="contactModel" OnValidSubmit="() => HandleSubmitAsync(poster.Id)">
                            <DataAnnotationsValidator />
                            <MudTextField T="string" @bind-Value="contactModel.ReplyToEmail" Placeholder="Your email" Class="mb-2" />
                            <MudTextField T="string" Lines="4" @bind-Value="contactModel.Message" Placeholder="Your message..." Class="mb-2" />
                            @if (!string.IsNullOrEmpty(errorMessage))
                            {
                                <MudAlert Severity="Severity.Error" Class="mt-2 mb-2">@errorMessage</MudAlert>
                            }
                            @if (!string.IsNullOrEmpty(successMessage))
                            {
                                <MudAlert Severity="Severity.Success" Class="mt-2 mb-2">@successMessage</MudAlert>
                            }
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@isBusy" Class="mt-2">Send</MudButton>
                        </EditForm>
                    }
                </li>
            }
        </ul>
    }
</MudContainer>

@code {
    private List<ResumePosterItem>? posters;
    private string? openPosterId;
    private readonly ContactModel contactModel = new();
    private string? errorMessage;
    private string? successMessage;
    private bool isBusy;

    protected override async Task OnInitializedAsync()
    {
        posters = await Http.GetFromJsonAsync<List<ResumePosterItem>>("api/resume-posters");
    }

    private void ToggleForm(string posterId)
    {
        errorMessage = null;
        successMessage = null;
        contactModel.Message = string.Empty;
        contactModel.ReplyToEmail = string.Empty;
        openPosterId = openPosterId == posterId ? null : posterId;
    }

    private async Task HandleSubmitAsync(string posterId)
    {
        isBusy = true;
        errorMessage = null;
        successMessage = null;

        var response = await Http.PostAsJsonAsync($"api/resume-posters/{posterId}/contact",
            new { message = contactModel.Message, replyToEmail = contactModel.ReplyToEmail });

        if (response.IsSuccessStatusCode)
        {
            successMessage = "Message sent!";
            contactModel.Message = string.Empty;
            contactModel.ReplyToEmail = string.Empty;
        }
        else
        {
            errorMessage = "Could not send your message. Please try again.";
        }

        isBusy = false;
    }

    private class ContactModel
    {
        [Required]
        public string Message { get; set; } = string.Empty;

        [Required]
        [EmailAddress]
        public string ReplyToEmail { get; set; } = string.Empty;
    }
}
