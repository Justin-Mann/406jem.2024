@page "/projects"
@using BlazorApp.Models
@using System.Net.Http.Json
@inject HttpClient Http

<PageTitle>Projects</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large">
    <MudText Class="pretty-text page-note" Align="Align.Center">
        This page has various resources related to my professional activities as well as side projects for reference and review. Resources include my public GitHub and discussions of side projects w/ relevant urls.
    </MudText>

    @if (listing is null)
    {
        <MudText Align="Align.Center">Loading...</MudText>
    }
    else if (listing.Sections.Count == 0)
    {
        <MudText Align="Align.Center">No project listings to show yet.</MudText>
    }
    else
    {
        <MudGrid Justify="Justify.Center" Spacing="4" Class="mt-2">
            @foreach (var projSection in listing.Sections)
            {
                <MudItem xs="12" sm="4">
                    <MudCard Class="jem-card" Elevation="0">
                        <MudCardHeader Class="card-header">
                            <CardHeaderContent>@projSection.Heading</CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent Class="card-body">
                            <ul class="project-menu-list-group">
                                @foreach (var link in projSection.Links)
                                {
                                    @if (string.IsNullOrEmpty(link.Description))
                                    {
                                        <li><MudLink Href="@link.Url" title="@link.Label" Target="_new">@link.Label</MudLink></li>
                                    }
                                    else
                                    {
                                        <li>
                                            <MudLink Href="@link.Url" title="@link.Label" Target="_new">@link.Label</MudLink>
                                            <ul>
                                                <li class="list-group-item-description">@link.Description</li>
                                            </ul>
                                        </li>
                                    }
                                }
                            </ul>
                        </MudCardContent>
                        @if (!string.IsNullOrEmpty(projSection.LastUpdated))
                        {
                            <MudCardActions Class="card-footer">Last Updated @projSection.LastUpdated</MudCardActions>
                        }
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

<AuthorizeView Roles="admin,superadmin" Context="authorizeContext">
    <Authorized>
        <MudContainer MaxWidth="MaxWidth.Large" Class="manage-projects-panel">
            <MudDivider Class="my-4" />
            @if (!showManagePanel)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" Class="manage-projects-toggle" OnClick="OpenManagePanelAsync">Manage My Project Listings</MudButton>
            }
            else
            {
                <MudText Typo="Typo.h5" Class="mb-3">Manage My Project Listings</MudText>

                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-3">@errorMessage</MudAlert>
                }

                @if (mine is null)
                {
                    <MudText>Loading your listings...</MudText>
                }
                else
                {
                    @if (editState is null)
                    {
                        @if (mine.Count == 0)
                        {
                            <MudText>You don't have any project listings yet.</MudText>
                        }
                        else
                        {
                            <ul class="manage-listing-list mb-3">
                                @foreach (var item in mine)
                                {
                                    <li class="manage-listing-item d-flex justify-space-between align-center">
                                        <span>
                                            @(item.Payload?.Title ?? "(untitled)")
                                            @if (item.IsFeatured)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Class="ms-2">Public</MudChip>
                                            }
                                        </span>
                                        <span>
                                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="listing-edit-btn" OnClick="() => StartEdit(item)">Edit</MudButton>
                                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Class="listing-delete-btn" Disabled="@isBusy" OnClick="() => DeleteAsync(item.Id)">Delete</MudButton>
                                        </span>
                                    </li>
                                }
                            </ul>
                        }
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="listing-new-btn" OnClick="StartNew">+ New Listing</MudButton>
                    }
                    else
                    {
                        var state = editState;
                        <EditForm Model="state" OnValidSubmit="SaveAsync">
                            <MudTextField T="string" Label="Title" @bind-Value="state.Payload.Title" Immediate="true" Class="mb-3 listing-title-input" />
                            <MudCheckBox T="bool" Label="Show publicly (Featured)" @bind-Value="state.IsFeatured" Class="mb-3 listing-featured-checkbox" />

                            @for (var sectionIndex = 0; sectionIndex < state.Payload.Sections.Count; sectionIndex++)
                            {
                                var section = state.Payload.Sections[sectionIndex];
                                var currentSectionIndex = sectionIndex;
                                <MudCard Class="mb-3" Elevation="0" Outlined="true">
                                    <MudCardContent>
                                        <MudStack Row="true" Spacing="2" Class="mb-2">
                                            <MudTextField T="string" Placeholder="Section heading" @bind-Value="section.Heading" Immediate="true" />
                                            <MudTextField T="string" Placeholder="Last updated (e.g. 08/2026)" @bind-Value="section.LastUpdated" Immediate="true" />
                                        </MudStack>

                                        @for (var linkIndex = 0; linkIndex < section.Links.Count; linkIndex++)
                                        {
                                            var link = section.Links[linkIndex];
                                            var currentLinkIndex = linkIndex;
                                            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mb-2 align-center">
                                                <MudTextField T="string" Placeholder="Label" @bind-Value="link.Label" Immediate="true" Class="flex-grow-1" />
                                                <MudTextField T="string" Placeholder="URL" @bind-Value="link.Url" Immediate="true" Class="flex-grow-1" />
                                                <MudTextField T="string" Placeholder="Description (optional)" @bind-Value="link.Description" Immediate="true" Class="flex-grow-1" />
                                                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Class="link-move-up-btn" Disabled="@(currentLinkIndex == 0)" OnClick="() => MoveLinkUp(section, currentLinkIndex)" />
                                                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" Class="link-move-down-btn" Disabled="@(currentLinkIndex == section.Links.Count - 1)" OnClick="() => MoveLinkDown(section, currentLinkIndex)" />
                                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error" Class="link-remove-btn" OnClick="() => RemoveLink(section, currentLinkIndex)" />
                                            </MudStack>
                                        }
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="link-add-btn" OnClick="() => AddLink(section)">+ Add Link</MudButton>

                                        <MudStack Row="true" Spacing="2" Class="mt-3" Justify="Justify.FlexEnd">
                                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="section-move-up-btn" Disabled="@(currentSectionIndex == 0)" OnClick="() => MoveSectionUp(currentSectionIndex)">&uarr; Section</MudButton>
                                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="section-move-down-btn" Disabled="@(currentSectionIndex == state.Payload.Sections.Count - 1)" OnClick="() => MoveSectionDown(currentSectionIndex)">&darr; Section</MudButton>
                                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Class="section-remove-btn" OnClick="() => RemoveSection(currentSectionIndex)">Remove Section</MudButton>
                                        </MudStack>
                                    </MudCardContent>
                                </MudCard>
                            }
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="section-add-btn mb-3" OnClick="AddSection">+ Add Section</MudButton>

                            <MudStack Row="true" Spacing="2">
                                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@isBusy" Class="listing-save-btn">Save</MudButton>
                                <MudButton Variant="Variant.Text" Color="Color.Secondary" Disabled="@isBusy" Class="listing-cancel-btn" OnClick="CancelEdit">Cancel</MudButton>
                            </MudStack>
                        </EditForm>
                    }
                }
            }
        </MudContainer>
    </Authorized>
</AuthorizeView>

@code {
    private ProjectListingModel? listing;
    private bool showManagePanel;
    private List<ProjectListingDto>? mine;
    private ListingEditState? editState;
    private string? errorMessage;
    private bool isBusy;

    protected override async Task OnInitializedAsync()
    {
        await LoadPublicListingAsync();
    }

    private async Task LoadPublicListingAsync()
    {
        try
        {
            listing = await Http.GetFromJsonAsync<ProjectListingModel>("api/projectlistings/public") ?? new ProjectListingModel();
        }
        catch
        {
            listing = new ProjectListingModel();
        }
    }

    private async Task OpenManagePanelAsync()
    {
        showManagePanel = true;
        await LoadMineAsync();
    }

    private async Task LoadMineAsync()
    {
        errorMessage = null;
        try
        {
            mine = await Http.GetFromJsonAsync<List<ProjectListingDto>>("api/projectlistings/mine");
        }
        catch
        {
            errorMessage = "Could not load your project listings.";
            mine = new List<ProjectListingDto>();
        }
    }

    private void StartNew()
    {
        editState = new ListingEditState
        {
            Id = null,
            IsFeatured = false,
            Payload = new ProjectListingModel
            {
                Title = "Projects",
                Sections = new List<ProjectSection>
                {
                    new() { Heading = string.Empty, Links = new List<ProjectLink> { new() } },
                },
            },
        };
    }

    private void StartEdit(ProjectListingDto item)
    {
        var payload = item.Payload ?? new ProjectListingModel();
        editState = new ListingEditState
        {
            Id = item.Id,
            IsFeatured = item.IsFeatured,
            Payload = new ProjectListingModel
            {
                Title = payload.Title,
                Sections = payload.Sections.Select(s => new ProjectSection
                {
                    Heading = s.Heading,
                    LastUpdated = s.LastUpdated,
                    Links = s.Links.Select(l => new ProjectLink { Label = l.Label, Url = l.Url, Description = l.Description }).ToList(),
                }).ToList(),
            },
        };
    }

    private void CancelEdit() => editState = null;

    private void AddSection() => editState!.Payload.Sections.Add(new ProjectSection { Heading = string.Empty, Links = new List<ProjectLink> { new() } });

    private void RemoveSection(int index) => editState!.Payload.Sections.RemoveAt(index);

    private void MoveSectionUp(int index) => Swap(editState!.Payload.Sections, index, index - 1);

    private void MoveSectionDown(int index) => Swap(editState!.Payload.Sections, index, index + 1);

    private void AddLink(ProjectSection section) => section.Links.Add(new ProjectLink());

    private void RemoveLink(ProjectSection section, int index) => section.Links.RemoveAt(index);

    private void MoveLinkUp(ProjectSection section, int index) => Swap(section.Links, index, index - 1);

    private void MoveLinkDown(ProjectSection section, int index) => Swap(section.Links, index, index + 1);

    private static void Swap<T>(List<T> list, int a, int b)
    {
        if (a < 0 || b < 0 || a >= list.Count || b >= list.Count)
        {
            return;
        }

        (list[a], list[b]) = (list[b], list[a]);
    }

    private async Task SaveAsync()
    {
        if (editState is null)
        {
            return;
        }

        isBusy = true;
        errorMessage = null;

        var request = new CreateOrUpdateProjectListingRequest
        {
            IsFeatured = editState.IsFeatured,
            Payload = editState.Payload,
        };

        var response = editState.Id is null
            ? await Http.PostAsJsonAsync("api/projectlistings", request)
            : await Http.PutAsJsonAsync($"api/projectlistings/{editState.Id}", request);

        if (response.IsSuccessStatusCode)
        {
            editState = null;
            await LoadMineAsync();
            await LoadPublicListingAsync();
        }
        else
        {
            errorMessage = "Could not save this project listing. Please try again.";
        }

        isBusy = false;
    }

    private async Task DeleteAsync(string id)
    {
        isBusy = true;
        errorMessage = null;

        var response = await Http.DeleteAsync($"api/projectlistings/{id}");
        if (response.IsSuccessStatusCode)
        {
            await LoadMineAsync();
            await LoadPublicListingAsync();
        }
        else
        {
            errorMessage = "Could not delete this project listing. Please try again.";
        }

        isBusy = false;
    }

    private class ListingEditState
    {
        public string? Id { get; set; }
        public bool IsFeatured { get; set; }
        public ProjectListingModel Payload { get; set; } = new();
    }
}
