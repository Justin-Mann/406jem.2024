@page "/testimonials"
@using BlazorApp.Models
@inject HttpClient Http

<PageTitle>Testimonials</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium">
    <MudText Typo="Typo.h4" Class="mb-2">Testimonials</MudText>
    <MudText Class="mb-4">Leave a note — you must be logged in to post, but anyone can read them.</MudText>

    <AuthorizeView Context="authContext">
        <Authorized>
            <EditForm Model="newTestimonial" OnValidSubmit="HandleSubmitAsync">
                <MudTextField T="string" Lines="3" @bind-Value="newTestimonial.Message" Placeholder="Leave a note..." Class="mb-2" />
                @if (!string.IsNullOrEmpty(errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Class="mt-2 mb-2">@errorMessage</MudAlert>
                }
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="@isBusy" Class="mt-2">Post</MudButton>
            </EditForm>
        </Authorized>
        <NotAuthorized>
            <MudText><MudLink Href="/login">Log in</MudLink> or <MudLink Href="/register">register</MudLink> to leave a testimonial.</MudText>
        </NotAuthorized>
    </AuthorizeView>

    <MudDivider Class="my-4" />

    @if (testimonials is null)
    {
        <MudText>Loading...</MudText>
    }
    else if (testimonials.Count == 0)
    {
        <MudText>No testimonials yet — be the first.</MudText>
    }
    else
    {
        <ul class="testimonial-list">
            @foreach (var testimonial in testimonials)
            {
                <li class="mb-3">
                    <strong>@testimonial.AuthorUsername</strong> — @testimonial.Message
                    @* SuperAdmin (#28) implies ResumeAdmin's "admin" permissions, mirroring the
                       backend's FunctionContextAuthExtensions.IsInRoleOrHigher. *@
                    <AuthorizeView Roles="admin,superadmin">
                        <Authorized>
                            <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" Class="testimonial-delete-btn" OnClick="() => DeleteTestimonialAsync(testimonial.Id)">Delete</MudButton>
                        </Authorized>
                    </AuthorizeView>
                </li>
            }
        </ul>
    }
</MudContainer>

@code {
    private List<TestimonialItem>? testimonials;
    private readonly NewTestimonialModel newTestimonial = new();
    private string? errorMessage;
    private bool isBusy;

    protected override async Task OnInitializedAsync()
    {
        await LoadTestimonialsAsync();
    }

    private async Task LoadTestimonialsAsync()
    {
        testimonials = await Http.GetFromJsonAsync<List<TestimonialItem>>("api/testimonials");
    }

    private async Task HandleSubmitAsync()
    {
        isBusy = true;
        errorMessage = null;

        var response = await Http.PostAsJsonAsync("api/testimonials", new { message = newTestimonial.Message });
        if (response.IsSuccessStatusCode)
        {
            newTestimonial.Message = string.Empty;
            await LoadTestimonialsAsync();
        }
        else
        {
            errorMessage = "Could not post your testimonial. Please try again.";
        }

        isBusy = false;
    }

    private async Task DeleteTestimonialAsync(string id)
    {
        var response = await Http.DeleteAsync($"api/testimonials/{id}");
        if (response.IsSuccessStatusCode)
        {
            await LoadTestimonialsAsync();
        }
    }

    private class NewTestimonialModel
    {
        public string Message { get; set; } = string.Empty;
    }
}
